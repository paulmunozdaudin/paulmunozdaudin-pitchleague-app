# ── Shared ────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=pitchleague
POSTGRES_PASSWORD=pitchleague
POSTGRES_DB=pitchleague
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://pitchleague:pitchleague@localhost:5432/pitchleague

# ── Backend (FastAPI) ────────────────────────────────────────────────────
# Shared secret used to verify JWTs minted by the frontend's NextAuth
# session (see docs/ARCHITECTURE.md#auth). Generate with `openssl rand -hex 32`.
AUTH_SHARED_SECRET=change-me-to-a-long-random-string
BACKEND_CORS_ORIGINS=http://localhost:3000

# Odds provider — see docs/ARCHITECTURE.md#adr-001-odds-provider for the
# comparison behind this choice. "mock" needs no key and is the default for
# local dev; switch to "the_odds_api" once you have a key.
ODDS_PROVIDER=mock
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# AI match insights — pluggable, defaults to the free heuristic provider.
AI_INSIGHTS_PROVIDER=heuristic
ANTHROPIC_API_KEY=

# Weekly virtual budget (credits) granted to each player per gameweek.
DEFAULT_GAMEWEEK_BUDGET=10000

# ── Frontend (Next.js / NextAuth) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
# Must match AUTH_SHARED_SECRET above — NextAuth signs a backend-compatible
# JWT with it so FastAPI can verify sessions without a shared session store.
NEXTAUTH_SECRET=change-me-to-a-long-random-string

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Apple requires a paid Apple Developer account + a generated client secret
# JWT; wired in lib/auth.ts behind a feature flag but not usable without it.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Temporary no-OAuth "guest name" login, for trying the product before
# Google/Discord OAuth apps exist. Both must be set to try it — turn both
# back to false once real sign-in is configured. See docs/DEPLOYMENT.md#modo-demo.
ENABLE_DEMO_LOGIN=false
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
